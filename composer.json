{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "barryvdh/laravel-dompdf": "^2.0",
        "bmatovu/laravel-mtn-momo": "^4.3",
        "bmatovu/oauth-negotiator": "^2.1",
        "doctrine/dbal": "^2.12.1",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^8.12",
        "laravel/nexmo-notification-channel": "^3.1",
        "laravel/tinker": "^2.5",
        "nexmo/client": "^2.4",
        "nexmo/laravel": "^3.0",
        "nwidart/laravel-modules": "8.2",
        "spatie/laravel-permission": "^5.2",
        "staudenmeir/laravel-adjacency-list": "^1.0",
        "twilio/sdk": "^7.5",
        "vonage/client": "^3.0"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-cv56-2228-pzr6": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    },
                    "PKSA-6r8f-nxsb-67bq": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    },
                    "PKSA-gh7h-hhy4-byg7": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    },
                    "PKSA-mwt3-h9tv-kx78": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    },
                    "PKSA-hp6n-n4kz-21wk": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    },
                    "PKSA-mckv-s5hg-868k": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    },
                    "PKSA-7ztm-rpt3-qqzk": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    },
                    "PKSA-2kw5-jd8w-5mvh": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    },
                    "PKSA-4jrs-y99s-q8j6": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    },
                    "PKSA-hbk6-2vfz-8f8n": {
                        "on-block": false,
                        "reason": "Temporary exception; remove after upgrading Dompdf."
                    }
                }
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
